# ── Supabase (client-side, shipped to browser via Vite) ──────────────────────
# Your Supabase project URL (Settings → API → Project URL)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous/public key (Settings → API → anon / public)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Supabase (server-side only, NEVER expose to browser) ─────────────────────
# Supabase service role key (Settings → API → service_role)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Opay ──────────────────────────────────────────────────────────────────────
# Get all three from: Opay Merchant Dashboard → Settings → API
OPAY_MERCHANT_ID=your-opay-merchant-id-here
OPAY_PUBLIC_KEY=your-opay-public-key-here
OPAY_SECRET_KEY=your-opay-secret-key-here
# Sandbox: https://testapi.opaycheckout.com | Production: https://liveapi.opaycheckout.com
OPAY_BASE_URL=https://liveapi.opaycheckout.com

# ── Monnify (optional second card-payment provider) ──────────────────────────
MONNIFY_API_KEY=your-monnify-api-key-here
MONNIFY_SECRET_KEY=your-monnify-secret-key-here
MONNIFY_CONTRACT_CODE=your-monnify-contract-code-here
MONNIFY_BASE_URL=https://api.monnify.com

# ── NOWPayments (crypto payments) ────────────────────────────────────────────
# API key — server-side only
# Get from: https://account.nowpayments.io/api-keys
NOWPAYMENTS_API_KEY=your-nowpayments-api-key-here

# ── Google OAuth (optional — handled through Supabase OAuth config) ───────────
# Not needed here: configure Google OAuth in Supabase Dashboard → Auth → Providers → Google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── Site URL ──────────────────────────────────────────────────────────────────
# Used for redirect URLs in payment callbacks
# VITE_SITE_URL=https://your-app.replit.app
# Admin API token for admin-only backend routes
ADMIN_API_TOKEN=your-secure-admin-token-here
